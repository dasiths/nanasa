{
  "name": "nanasa",
  "version": "0.0.0",
  "description": "Local tmux-backed coding-agent pool with a Fastify daemon and React portal",
  "license": "MIT",
  "homepage": "https://github.com/dasiths/nanasa#readme",
  "bugs": {
    "url": "https://github.com/dasiths/nanasa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dasiths/nanasa.git"
  },
  "keywords": [
    "coding-agent",
    "tmux",
    "ttyd"
  ],
  "type": "module",
  "bin": {
    "nanasa": "bin/nanasa.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nanasa/daemon --filter @nanasa/portal dev",
    "start": "NODE_ENV=production pnpm --filter @nanasa/daemon start",
    "build": "pnpm --filter @nanasa/contracts build && pnpm --filter @nanasa/daemon build && pnpm --filter @nanasa/portal build",
    "package:build": "node scripts/build-package.mjs",
    "package:test": "node --test test/package-cli.test.mjs",
    "prepack": "pnpm package:build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm -r --if-present test && pnpm package:test",
    "smoke": "pnpm --filter @nanasa/daemon smoke"
  },
  "dependencies": {
    "@fastify/http-proxy": "11.6.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.11.0",
    "ws": "8.21.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "^4.1.10"
  }
}
