{
  "harness": "copilot",
  "version": "1.0.79",
  "reporterVersion": "2",
  "captureDate": "2026-08-11",
  "scenario": "lifecycle-parallel-tools-waits-compaction-failure",
  "declaredEvents": [
    "session.ready",
    "turn.started",
    "turn.settled",
    "tool.started",
    "tool.finished",
    "tool.failed",
    "wait.opened",
    "wait.closed",
    "compaction.started",
    "failure.observed",
    "session.ended"
  ],
  "limitations": ["no-heartbeat", "no-effective-model", "no-action-correlation"],
  "hooks": [
    "sessionStart",
    "userPromptSubmitted",
    "preToolUse",
    "preToolUse",
    "postToolUse",
    "postToolUseFailure",
    "preToolUse",
    "postToolUse",
    "preToolUse",
    "postToolUse",
    "permissionRequest",
    "postToolUse",
    "postToolUseFailure",
    "errorOccurred",
    "preCompact",
    "agentStop",
    "sessionEnd"
  ]
}
