{
  "version": 1,
  "profiles": {
    "copilot-from-environment": {
      "provider": "copilot",
      "source": "environment",
      "sourceEnvironment": "NANASA_EXAMPLE_GITHUB_TOKEN",
      "targetEnvironment": "GH_TOKEN"
    },
    "claude-from-helper": {
      "provider": "claude-code",
      "source": "helper",
      "targetEnvironment": "ANTHROPIC_API_KEY",
      "helperCommand": ["pass", "show", "nanasa/claude-code"]
    }
  }
}
