    {
      "name": "nanasa.wait_action",
      "description": "Wait for a caller-owned exact action",
      "principals": [
        "agent",
        "operator"
      ],
      "scope": "actions:wait:own",
      "authority": "read",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "states": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "created",
                "deferred",
                "submitted",
                "accepted",
                "started",
                "blocked",
                "completed",
                "settled-unverified",
                "failed",
                "stalled",
                "timed-out",
                "cancelled",
                "expired",
                "superseded",
                "rejected"
              ]
            }
          },
          "timeoutMs": {
            "default": 30000,
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          }
        },
        "required": [
          "actionId",
          "states",
          "timeoutMs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "nanasa.cancel_action",
      "description": "Cancel a caller-owned pending action",
